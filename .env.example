# Required in production (min 32 chars)
AIACT_SESSION_SECRET=replace-with-a-long-random-string-minimum-32-chars

# Supabase backend (shared with CompliAI). Required for cross-cold-start
# persistence on Vercel. Leave unset for local-JSON-only dev mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend selectors — read by the legacy CompliAI-shared code.
# Use "supabase" for production, "local" (or unset) for dev.
COMPLISCAN_AUTH_BACKEND=supabase
COMPLISCAN_DATA_BACKEND=supabase

# Optional
# NODE_ENV=production
