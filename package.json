{
  "name": "eu-ai-act",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "AIACT_FORCE_INSECURE_COOKIES=1 next start -p 3101",
    "lint": "next lint",
    "test": "vitest",
    "e2e:live:chatbot": "node scripts/run-live-e2e-chatbot.mjs",
    "e2e:live:fixture": "node scripts/run-live-e2e-chatbot.mjs",
    "e2e:live:fixtures": "node scripts/run-live-e2e-fixture-matrix.mjs",
    "test:e2e:fixtures": "npm run e2e:live:fixtures",
    "test:e2e:fixtures:ui": "playwright test -c playwright.config.ts tests/e2e/compliroai-fixture-matrix.ui.spec.ts",
    "test:e2e:fixtures:ui:headed": "playwright test -c playwright.config.ts tests/e2e/compliroai-fixture-matrix.ui.spec.ts --headed",
    "test:e2e:fixtures:ui:dev": "COMPLIROAI_SERVER_MODE=dev COMPLIROAI_PORT=3001 COMPLIROAI_BASE_URL=http://127.0.0.1:3001 playwright test -c playwright.config.ts tests/e2e/compliroai-fixture-matrix.ui.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@types/pdfkit": "^0.17.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "nanoid": "^3.3.12",
    "next": "15.5.18",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.15.2",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.7",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
